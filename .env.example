# انسخ هذه القيم إلى Railway > Variables (لا ترفع ملف .env إلى GitHub)
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=غيّرها-كلمة-مرور-طويلة-10-أحرف-على-الأقل
DB_FILE=/data/app.db
COOKIE_SECURE=1
TRUST_PROXY=1
SEED_DEMO=0
OPERATOR_NAME=اسم الجهة المشغّلة للموقع
CONTACT_EMAIL=privacy@your-domain.example
SITE_URL=https://your-domain.example
# بريد استعادة كلمة المرور (راجع EMAIL.md). بدونه تُعطَّل الاستعادة في الإنتاج
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=Qatar Guide <no-reply@your-domain.example>
# تفعيل البريد قبل النشر (الافتراضي مفعّل عند ضبط البريد). ضع 0 لإيقافه
REQUIRE_VERIFIED_EMAIL=1
NODE_ENV=production
